# Скопируйте в .env:  copy .env.example .env
# .env в git не попадает.

# Для docker compose хост — имя сервиса `db`, порт внутри сети 5432.
DATABASE_URL=postgresql+asyncpg://fitness:fitness@db:5432/fitness

# Для локального запуска API без контейнера (на хосте Postgres опубликован как 5433):
# DATABASE_URL=postgresql+asyncpg://fitness:fitness@127.0.0.1:5433/fitness

# Приложение не запустится с этой заготовкой. Сгенерируйте свою:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# В коде по умолчанию true: cookie только по HTTPS.
# Для http://localhost оставьте false, иначе браузер не сохранит сессию.
COOKIE_SECURE=false

# IP или CIDR доверенного прокси через запятую.
# Пусто — брать адрес соединения и игнорировать X-Forwarded-For.
TRUSTED_PROXIES=
